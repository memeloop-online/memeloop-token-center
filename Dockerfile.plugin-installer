# syntax=docker/dockerfile:1.7
ARG RUST_IMAGE=rust:1.95.0-bookworm
ARG GO_IMAGE=golang:1.27.3-bookworm
ARG RUNTIME_IMAGE=gcr.io/distroless/base-nossl-debian13:nonroot

FROM ${GO_IMAGE} AS cosign-builder
ADD --checksum=sha256:424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa \
    https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-amd64 /tmp/cosign
ADD --checksum=sha256:c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4 \
    https://raw.githubusercontent.com/sigstore/cosign/0e48502cf5ef34e2e60bbd3617aa19945712f705/LICENSE /build/cosign/LICENSE
RUN chmod 0555 /tmp/cosign \
    && go version -m /tmp/cosign | grep -Eq 'go1\.27\.3$' \
    && go version -m /tmp/cosign | grep -Eq '[[:space:]]dep[[:space:]]+github.com/klauspost/compress[[:space:]]+v1\.20\.1[[:space:]]' \
    && /tmp/cosign version --json \
      | grep -Eq '"gitVersion"[[:space:]]*:[[:space:]]*"v3\.1\.4"'

FROM ${RUST_IMAGE} AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake clang perl pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY .cargo/config.toml /build/.cargo/config.toml
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
# Compile the locked dependency graph before application sources are copied.
# Source-only changes can then reuse this expensive release layer in both the
# packaging contract and the immutable publication build.
RUN mkdir -p src/bin tests \
    && printf 'pub fn dependency_cache_marker() {}\n' > src/lib.rs \
    && printf 'fn main() {}\n' > src/bin/install-plugin-oci.rs \
    && printf 'fn main() {}\n' > tests/cucumber.rs \
    && cargo build --locked --release --features plugin-distribution,experimental-plugin-revisions --bin install-plugin-oci \
    && cargo clean --release --package memeloop-token-center \
    && rm -rf src tests
COPY src ./src
COPY migrations ./migrations
COPY schemas ./schemas
COPY openapi/openapi.json ./openapi/openapi.json
COPY wit ./wit
# Cargo validates explicitly declared test targets even when only the installer
# binary is built. Keep the production image context small while satisfying the
# manifest contract; this placeholder is never compiled by the command below.
RUN mkdir -p tests && printf 'fn main() {}\n' > tests/cucumber.rs
RUN cargo build --locked --release --features plugin-distribution,experimental-plugin-revisions --bin install-plugin-oci \
    && install -m 0755 target/release/install-plugin-oci /tmp/install-plugin-oci \
    && cp "$(gcc -print-file-name=libgcc_s.so.1)" /tmp/libgcc_s.so.1

FROM ${RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="MemeLoop Token Center OCI plugin installer" \
      org.opencontainers.image.description="Digest-pinned OCI plugin installer with official Cosign v3.1.4" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.memeloop.cosign.version="v3.1.4" \
      io.memeloop.cosign.upstream-commit="0e48502cf5ef34e2e60bbd3617aa19945712f705"
ENV LD_LIBRARY_PATH=/usr/local/lib
COPY --from=cosign-builder /tmp/cosign /usr/local/bin/cosign
COPY --from=builder /tmp/libgcc_s.so.1 /usr/local/lib/libgcc_s.so.1
COPY --from=builder /tmp/install-plugin-oci /usr/local/bin/install-plugin-oci
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/install-plugin-oci"]
