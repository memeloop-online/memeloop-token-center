# syntax=docker/dockerfile:1.7
ARG RUST_IMAGE=rust:1.95.0-bookworm
ARG DOWNLOAD_IMAGE=debian:bookworm-slim
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM ${DOWNLOAD_IMAGE} AS cosign
ARG TARGETARCH
ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
RUN sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# Cosign 3.1.3 fixes GHSA-fx35-mq7g-6g98. Both hashes come from the digest
# fields of the official v3.1.3 GitHub Release assets. Version and hashes are
# deliberately not build arguments: callers cannot substitute another binary.
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) expected='4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71' ;; \
      arm64) expected='c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a' ;; \
      *) echo "unsupported Cosign architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --proto '=https' --tlsv1.2 --retry 5 \
      --output /tmp/cosign \
      "https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-${TARGETARCH}"; \
    echo "${expected}  /tmp/cosign" | sha256sum --check --strict; \
    install -m 0755 /tmp/cosign /usr/local/bin/cosign; \
    /usr/local/bin/cosign version --json \
      | grep -Eq '"gitVersion"[[:space:]]*:[[:space:]]*"v3\.1\.3"'

FROM ${RUST_IMAGE} AS builder
ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG CARGO_REGISTRY=sparse+https://rsproxy.cn/index/
RUN sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends cmake clang perl pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /usr/local/cargo \
    && printf '[source.crates-io]\nreplace-with = "build-mirror"\n[source.build-mirror]\nregistry = "%s"\n' "${CARGO_REGISTRY}" \
      > /usr/local/cargo/config.toml
WORKDIR /build
COPY .cargo/config.toml /build/.cargo/config.toml
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY src ./src
COPY migrations ./migrations
COPY schemas ./schemas
COPY wit ./wit
# Cargo validates explicitly declared test targets even when only the installer
# binary is built. Keep the production image context small while satisfying the
# manifest contract; this placeholder is never compiled by the command below.
RUN mkdir -p tests && printf 'fn main() {}\n' > tests/cucumber.rs
RUN cargo build --locked --release --features plugin-distribution --bin install-plugin-oci \
    && install -m 0755 target/release/install-plugin-oci /tmp/install-plugin-oci

FROM ${RUNTIME_IMAGE}
ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
LABEL org.opencontainers.image.title="MemeLoop Token Center OCI plugin installer" \
      org.opencontainers.image.description="Digest-pinned OCI plugin installer with official Cosign v3.1.3 verification" \
      io.memeloop.cosign.version="v3.1.3"
RUN sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home token-center-installer
COPY --from=cosign /usr/local/bin/cosign /usr/local/bin/cosign
COPY --from=builder /tmp/install-plugin-oci /usr/local/bin/install-plugin-oci
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/install-plugin-oci"]
