# syntax=docker/dockerfile:1.7
ARG RUST_IMAGE=rust:1.95.0-bookworm
ARG GO_IMAGE=golang:1.26.7-bookworm
ARG RUNTIME_IMAGE=gcr.io/distroless/base-nossl-debian13:nonroot

# Upstream has not published a release newer than v3.1.3. Build its verified
# tag commit with only the dependency/Go security backports recorded in the
# checked-in patch. The remote archive cannot change without also changing the
# literal checksum below.
FROM ${GO_IMAGE} AS cosign-builder
ADD --checksum=sha256:3a718446bac51466efff6853639e1ca108b456ecbf07cd92938f548715d22d6b \
    https://codeload.github.com/sigstore/cosign/tar.gz/11926fa5bbbbde47e88fc006b625a17769b743b2 \
    /tmp/cosign.tar.gz
RUN mkdir -p /build/cosign \
    && tar -xzf /tmp/cosign.tar.gz -C /build/cosign --strip-components=1
WORKDIR /build/cosign
COPY packaging/cosign/v3.1.3-security.patch /tmp/v3.1.3-security.patch
RUN git apply --unidiff-zero --check /tmp/v3.1.3-security.patch \
    && git apply --unidiff-zero /tmp/v3.1.3-security.patch \
    && GOTOOLCHAIN=local go mod verify \
    && CGO_ENABLED=0 GOTOOLCHAIN=local go build -trimpath \
      -ldflags '-buildid= -X sigs.k8s.io/release-utils/version.gitVersion=v3.1.3-mtc.1 -X sigs.k8s.io/release-utils/version.gitCommit=11926fa5bbbbde47e88fc006b625a17769b743b2 -X sigs.k8s.io/release-utils/version.gitTreeState=clean -X sigs.k8s.io/release-utils/version.buildDate=2026-08-06T00:10:15Z' \
      -o /tmp/cosign ./cmd/cosign \
    && /tmp/cosign version --json \
      | grep -Eq '"gitVersion"[[:space:]]*:[[:space:]]*"v3\.1\.3-mtc\.1"'

FROM ${RUST_IMAGE} AS builder
ARG CARGO_REGISTRY=sparse+https://rsproxy.cn/index/
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake clang perl pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /usr/local/cargo \
    && printf '[source.crates-io]\nreplace-with = "build-mirror"\n[source.build-mirror]\nregistry = "%s"\n' "${CARGO_REGISTRY}" \
      > /usr/local/cargo/config.toml
WORKDIR /build
COPY .cargo/config.toml /build/.cargo/config.toml
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY src ./src
COPY migrations ./migrations
COPY schemas ./schemas
COPY wit ./wit
# Cargo validates explicitly declared test targets even when only the installer
# binary is built. Keep the production image context small while satisfying the
# manifest contract; this placeholder is never compiled by the command below.
RUN mkdir -p tests && printf 'fn main() {}\n' > tests/cucumber.rs
RUN cargo build --locked --release --features plugin-distribution --bin install-plugin-oci \
    && install -m 0755 target/release/install-plugin-oci /tmp/install-plugin-oci \
    && cp "$(gcc -print-file-name=libgcc_s.so.1)" /tmp/libgcc_s.so.1

FROM ${RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="MemeLoop Token Center OCI plugin installer" \
      org.opencontainers.image.description="Digest-pinned OCI plugin installer with Cosign v3.1.3 security backports" \
      io.memeloop.cosign.version="v3.1.3-mtc.1" \
      io.memeloop.cosign.upstream-commit="11926fa5bbbbde47e88fc006b625a17769b743b2"
ENV LD_LIBRARY_PATH=/usr/local/lib
COPY --from=cosign-builder /tmp/cosign /usr/local/bin/cosign
COPY --from=builder /tmp/libgcc_s.so.1 /usr/local/lib/libgcc_s.so.1
COPY --from=builder /tmp/install-plugin-oci /usr/local/bin/install-plugin-oci
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/install-plugin-oci"]
