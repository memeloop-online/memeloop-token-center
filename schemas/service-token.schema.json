{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memeloop.dev/token-center/schemas/service-token.schema.json",
  "title": "Service credential",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "scopes"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "tenant_external_id": {
      "type": ["string", "null"],
      "title": "Restrict to tenant",
      "description": "Leave empty only for a global operator integration."
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "keys:write",
          "keys:read",
          "credits:write",
          "credits:read",
          "requests:read",
          "providers:read",
          "providers:write",
          "plugins:read",
          "oauth:write",
          "routes:write",
          "routes:read",
          "prices:write",
          "prices:read",
          "service_tokens:write",
          "service_tokens:read",
          "schemas:read",
          "metrics:read",
          "entitlements:read",
          "entitlements:write"
        ]
      }
    }
  }
}
