{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memeloop.dev/token-center/schemas/model-price.schema.json",
  "title": "Token model price",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_per_million", "output_per_million"],
  "properties": {
    "input_per_million": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$" },
    "cached_input_per_million": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$" },
    "cache_write_per_million": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$" },
    "output_per_million": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$" },
    "service_tier": {
      "type": "string",
      "default": "default",
      "enum": ["default", "auto", "priority", "flex", "scale", "batch", "standard_only"]
    }
  }
}
