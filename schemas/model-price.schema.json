{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memeloop.dev/token-center/schemas/model-price.schema.json",
  "title": "Token model price",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_per_million", "output_per_million"],
  "properties": {
    "input_per_million": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$" },
    "output_per_million": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$" }
  }
}
