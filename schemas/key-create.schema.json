{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memeloop.dev/token-center/schemas/key-create.schema.json",
  "title": "Downstream credential",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal_external_id", "alias"],
  "properties": {
    "tenant_external_id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "default": "default", "title": "Tenant" },
    "principal_external_id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "title": "Principal" },
    "alias": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "title": "Credential alias" },
    "currency": { "enum": ["USD", "CNY"], "default": "USD" },
    "initial_balance": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
      "default": "0",
      "title": "Initial credit"
    },
    "route_ids": {
      "title": "Model routes",
      "description": "Exact model routes granted to this credential. An empty array grants no routes.",
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" },
      "default": []
    },
    "route_group_ids": {
      "title": "Route groups",
      "description": "Route groups granted to this credential. An empty array grants no route groups.",
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" },
      "default": []
    },
    "policy": {
      "title": "Policy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": { "type": "integer", "minimum": 1, "maximum": 4294967295, "default": 60 },
        "tokens_per_minute": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "default": 100000 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 4294967295, "default": 4 },
        "enforcement_mode": {
          "title": "Enforcement mode",
          "description": "Prepaid enforces balance and policy limits synchronously. Metered unlimited records exact postpaid usage without those shared admission limits.",
          "oneOf": [
            { "const": "prepaid", "title": "Prepaid limits" },
            { "const": "metered_unlimited", "title": "Metered unlimited" }
          ],
          "default": "prepaid"
        },
        "daily_budget": { "$ref": "#/$defs/decimal" },
        "weekly_budget": { "$ref": "#/$defs/decimal" },
        "lifetime_budget": { "$ref": "#/$defs/decimal" }
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": ["string", "null"],
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    }
  }
}
