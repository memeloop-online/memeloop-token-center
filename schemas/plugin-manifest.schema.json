{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memeloop.dev/schemas/plugin-manifest.schema.json",
  "title": "Token Center plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "wit_version"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "wit_version": {
      "type": "string",
      "pattern": "^0\\.2\\.(0|[1-9][0-9]*)$",
      "description": "Compatible Token Center 0.2 WIT contract version."
    },
    "wasm": {
      "type": ["string", "null"],
      "default": "plugin.wasm",
      "description": "Set null for a manifest-only provider contribution."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "const": "log" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "const": "kv" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "allowed_origins"],
            "properties": {
              "kind": { "const": "http" },
              "allowed_origins": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "format": "uri" }
              }
            }
          }
        ]
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traffic_policy": { "type": "boolean", "default": false },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "display_name",
              "protocols",
              "modalities",
              "config_schema",
              "credential_schema"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9-]+$"
              },
              "display_name": { "type": "string", "minLength": 1 },
              "protocols": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["openai", "anthropic", "generation"]
                }
              },
              "modalities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["text", "embedding", "image", "video", "audio"]
                }
              },
              "config_schema": { "type": ["object", "boolean"] },
              "credential_schema": { "type": ["object", "boolean"] },
              "oauth_adapter": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["api_version", "flow_kind", "login_url", "poll_url", "refresh_url"],
                  "properties": {
                    "api_version": { "const": "oauth-adapter-v1" },
                    "flow_kind": { "const": "cursor_pkce" },
                    "login_url": { "type": "string", "format": "uri" },
                  "poll_url": { "type": "string", "format": "uri" },
                  "refresh_url": { "type": "string", "format": "uri" }
                }
              },
              "managed_oauth_adapter": {
                "type": "object",
                "additionalProperties": false,
                "required": ["api_version", "source_types", "normalize_url", "refresh_url"],
                "properties": {
                  "api_version": { "const": "cpa-managed-oauth-adapter-v1" },
                  "source_types": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9._-]+$"
                    }
                  },
                  "normalize_url": { "type": "string", "format": "uri" },
                  "refresh_url": { "type": "string", "format": "uri" }
                }
              },
              "component_adapter": {
                "type": "object",
                "additionalProperties": false,
                "required": ["api_version", "max_response_bytes"],
                "properties": {
                  "api_version": {
                    "const": "buffered-v1",
                    "description": "Explicitly opts into prepare/normalize; streaming is unsupported and rejected."
                  },
                  "max_response_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4194304
                  }
                }
              },
              "source": { "type": "string", "readOnly": true }
            }
          }
        }
      }
    }
  }
}
