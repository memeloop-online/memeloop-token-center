{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memeloop.dev/schemas/plugin-manifest.schema.json",
  "title": "Token Center plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "wit_version"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "wit_version": {
      "type": "string",
      "pattern": "^0\\.2\\.(0|[1-9][0-9]*)$",
      "description": "Compatible Token Center 0.2 WIT contract version."
    },
    "wasm": {
      "type": ["string", "null"],
      "default": "plugin.wasm",
      "description": "Set null for a manifest-only provider contribution."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "const": "group_routing_quota" } },
            "description": "Read-only account-windows-v1 context for group routing with native health; grants no network or KV access."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "const": "log" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "const": "kv" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "allowed_origins"],
            "properties": {
              "kind": { "const": "http" },
              "allowed_origins": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "format": "uri" }
              }
            }
          }
        ]
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traffic_policy": { "type": "boolean", "default": false },
        "group_routing": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["version", "schema", "default"],
          "properties": {
            "version": { "enum": ["group-routing-v1", "group-routing-v2"] },
            "health_policy": {
              "enum": ["plugin", "native"],
              "default": "plugin",
              "description": "Native applies the validated order only; core admission, recovery and terminal health behavior are unchanged."
            },
            "schema": {
              "type": "object",
              "description": "Object-root credential-free group strategy configuration schema; writeOnly fields are forbidden."
            },
            "default": { "type": "object" }
          },
          "description": "Independent group-routing-plugin WIT world. Requires a component; host validates this contribution's configuration schema and default."
        },
        "request_rewrite": {
          "type": "boolean",
          "default": false,
          "description": "Contributes bounded post-auth model, route, or canonical request rewriting through the WIT traffic-policy hook."
        },
        "configuration": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": {
              "type": "object",
              "description": "CSP-safe JSON Schema rendered by the operator and validated by the service. writeOnly fields are forbidden; credentials use provider credential_schema."
            },
            "default": {
              "default": {},
              "description": "Validated global fallback when no persisted global or tenant override exists."
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "display_name",
              "protocols",
              "modalities",
              "config_schema",
              "credential_schema"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9-]+$"
              },
              "display_name": { "type": "string", "minLength": 1 },
              "protocols": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["openai", "anthropic", "generation"]
                }
              },
              "modalities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["text", "embedding", "image", "video", "audio"]
                }
              },
              "config_schema": { "type": ["object", "boolean"] },
              "credential_schema": { "type": ["object", "boolean"] },
              "oauth_adapter": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["api_version", "flow_kind", "login_url", "poll_url", "refresh_url"],
                  "properties": {
                    "api_version": { "const": "oauth-adapter-v1" },
                    "flow_kind": { "enum": ["cursor_pkce", "authorization_code_pkce"] },
                    "login_url": { "type": "string", "format": "uri" },
                  "poll_url": { "type": "string", "format": "uri" },
                  "refresh_url": { "type": "string", "format": "uri" }
                }
              },
              "component_adapter": {
                "type": "object",
                "additionalProperties": false,
                "required": ["api_version", "max_response_bytes"],
                "properties": {
                  "api_version": {
                    "const": "buffered-v1",
                    "description": "Explicitly opts into prepare/normalize; streaming is unsupported and rejected."
                  },
                  "max_response_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4194304
                  }
                }
              },
              "request_compatibility": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "third_party": {
                    "type": "boolean",
                    "default": false,
                    "description": "Explicitly identifies a non-native upstream contract; this is never inferred from a URL or model name."
                  },
                  "responses_via_chat_v1": {
                    "type": "boolean",
                    "default": false,
                    "description": "Explicitly identifies a provider adapter that translates OpenAI Responses through Chat Completions."
                  },
                  "responses_via_chat_dialect": {
                    "type": "string",
                    "enum": ["openai_chat_v1", "kimi_v1"],
                    "description": "Closed, versioned Responses-via-Chat wire dialect. Required when responses_via_chat_v1 is true."
                  },
                  "codex_multi_agent_v2": {
                    "type": "boolean",
                    "default": false,
                    "description": "Opt in to the host's Codex MultiAgentV2 request normalization for this provider."
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": ["responses_via_chat_v1"],
                      "properties": {
                        "responses_via_chat_v1": {"const": true}
                      }
                    },
                    "then": {
                      "required": ["responses_via_chat_dialect"]
                    }
                  },
                  {
                    "if": {
                      "required": ["responses_via_chat_dialect"]
                    },
                    "then": {
                      "properties": {
                        "responses_via_chat_v1": {"const": true}
                      }
                    }
                  }
                ]
              },
              "codex_model_capabilities": {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "agent_instructions_template", "shell_type", "input_modalities"],
                "description": "Versioned, fixed, non-secret Codex model-directory capabilities for an explicitly compatible provider. Account, route, and upstream identity must never be included.",
                "properties": {
                  "version": {
                    "const": "codex-model-capabilities-v1"
                  },
                  "agent_instructions_template": {
                    "const": "codex-generic-agent-v1"
                  },
                  "shell_type": {
                    "type": "string",
                    "enum": ["disabled", "unified_exec"]
                  },
                  "apply_patch_tool_type": {
                    "type": ["string", "null"],
                    "enum": ["freeform", null]
                  },
                  "fallback_context_window": {
                    "type": ["integer", "null"],
                    "minimum": 1
                  },
                  "input_modalities": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": ["text", "image"]
                    }
                  },
                  "supports_image_detail_original": {
                    "type": "boolean",
                    "default": false
                  },
                  "include_skills_usage_instructions": {
                    "type": "boolean",
                    "default": false
                  },
                  "include_plugin_usage_instructions": {
                    "type": "boolean",
                    "default": false
                  },
                  "include_apps_usage_instructions": {
                    "type": "boolean",
                    "default": false
                  },
                  "supported_reasoning_levels": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["effort", "description"],
                      "properties": {
                        "effort": {
                          "type": "string",
                          "enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra"]
                        },
                        "description": {"type": "string", "minLength": 1}
                      }
                    }
                  },
                  "default_reasoning_level": {
                    "type": ["string", "null"],
                    "enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra", null]
                  }
                }
              },
              "source": { "type": "string", "readOnly": true }
            }
          }
        },
        "operator_ui": {
          "type": "array",
          "description": "Operator navigation and fixed-slot cards. typed_data_v1 uses core projections; component_v1 loads a signed, digest-addressed module from the installed plugin package.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "slot", "label", "icon", "renderer"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
              "slot": { "enum": ["operator.sidebar.tab", "operator.overview.card", "operator.page.before", "operator.page.after"] },
              "category": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
                  "label": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$" }
                }
              },
              "route": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
              "target_route": { "enum": ["overview", "requests", "sessions", "usage", "generations", "providers", "routes", "pricing", "tenants", "credentials", "service-credentials", "plugins", "system-settings"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$" },
              "icon": { "enum": ["activity", "chart", "database", "heart", "plug", "shield"] },
              "renderer": { "enum": ["typed_data_v1", "component_v1"] },
              "module_entry": {
                "type": "string",
                "minLength": 4,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9._/-]+\\.m?js$",
                "allOf": [
                  { "not": { "pattern": "(^/|//)" } },
                  { "not": { "pattern": "(^|/)\\.{1,2}(/|$)" } }
                ]
              },
              "component_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
              "component_props": { "type": "object" },
              "presentation": {
                "enum": ["health_intelligence_v1", "projection_v1"],
                "description": "Optional core-owned typed-data presentation."
              },
              "data_endpoint": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" }
            },
            "allOf": [
              {
                "if": { "properties": { "renderer": { "const": "typed_data_v1" } }, "required": ["renderer"] },
                "then": { "required": ["data_endpoint"], "not": { "anyOf": [{ "required": ["module_entry"] }, { "required": ["component_id"] }, { "required": ["component_props"] }] } }
              },
              {
                "if": { "properties": { "renderer": { "const": "component_v1" } }, "required": ["renderer"] },
                "then": { "required": ["module_entry", "component_id"], "not": { "required": ["presentation"] } }
              },
              {
                "if": { "properties": { "slot": { "const": "operator.sidebar.tab" } }, "required": ["slot"] },
                "then": { "required": ["route", "category"], "not": { "required": ["target_route"] } }
              },
              {
                "if": { "properties": { "slot": { "const": "operator.overview.card" } }, "required": ["slot"] },
                "then": { "not": { "anyOf": [{ "required": ["route"] }, { "required": ["category"] }, { "required": ["target_route"] }] } }
              },
              {
                "if": { "properties": { "slot": { "enum": ["operator.page.before", "operator.page.after"] } }, "required": ["slot"] },
                "then": { "required": ["target_route"], "not": { "anyOf": [{ "required": ["route"] }, { "required": ["category"] }] } }
              }
            ]
          }
        },
        "service_data": {
          "type": "array",
          "description": "Server-only GET feeds. Each URL must be an HTTPS origin declared by the plugin HTTP capability; browser credentials are never forwarded.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "required_scope", "response_schema"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
              "url": { "type": "string", "format": "uri", "maxLength": 2048 },
              "required_scope": { "enum": ["credits:read", "entitlements:read", "keys:read", "metrics:read", "plugins:read", "prices:read", "providers:read", "requests:read", "routes:read", "schemas:read", "service_tokens:read", "tenants:read"] },
              "response_schema": { "type": "object", "description": "Non-secret JSON Schema with an object root. writeOnly fields are forbidden." },
              "fallback": { "default": {}, "description": "Schema-valid data returned on an upstream failure when no stale cache entry is available." },
              "cache_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 },
              "timeout_millis": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 2000 },
              "max_body_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 65536 }
            }
          }
        }
      }
    }
  }
}
