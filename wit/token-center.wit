package memeloop:token-center@0.2.0;

interface types {
  record request-context {
    tenant-id: string,
    principal-id: string,
    key-id: string,
    protocol: string,
    model: string,
    config-json: string,
  }

  record decision {
    allow: bool,
    reason: option<string>,
    model: option<string>,
    upstream-account-id: option<string>,
    request-json: option<string>,
  }

  record metering {
    currency: string,
    amount: string,
    input-tokens: u64,
    output-tokens: u64,
    estimated: bool,
  }
}

interface host {
  log: func(level: string, message: string);
  kv-get: func(key: string) -> result<option<list<u8>>, string>;
  kv-put: func(key: string, value: list<u8>) -> result<_, string>;
  http-request: func(method: string, url: string, headers-json: string, body: list<u8>) -> result<list<u8>, string>;
}

interface traffic-policy {
  use types.{request-context, decision};
  post-auth: func(context: request-context, request-json: string) -> result<decision, string>;
}

interface upstream-provider {
  use types.{request-context, metering};
  list-models: func(config-json: string) -> result<string, string>;
  quote: func(context: request-context, request-json: string) -> result<metering, string>;

  /// Convert one canonical, credential-free request into a bounded upstream
  /// request. The JSON result is the buffered-v1 envelope documented by the
  /// host. It contains method, relative path, non-secret headers, base64 body,
  /// and a streaming=false assertion. The host validates every field and adds
  /// the stable upstream account credential only after this call returns.
  prepare: func(context: request-context, config-json: string, request-json: string) -> result<string, string>;

  /// Convert one bounded, credential-free upstream response envelope into the
  /// public protocol response and token usage. This ABI is deliberately
  /// buffered-only; a route requesting streaming is rejected by the host
  /// before the component is invoked.
  normalize: func(context: request-context, response-json: string) -> result<string, string>;
}

world plugin {
  import host;
  export traffic-policy;
  export upstream-provider;
}
