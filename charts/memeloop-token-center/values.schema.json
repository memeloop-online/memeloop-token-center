{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "memeloop-token-center Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "migration",
    "serviceAccount",
    "roles",
    "config",
    "plugins",
    "ingress",
    "podAnnotations",
    "podLabels",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "terminationGracePeriodSeconds",
    "revisionHistoryLimit",
    "deploymentStrategy",
    "probes",
    "networkPolicy",
    "serviceMonitor"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "description": "Optional immutable image digest. When set, it takes precedence over tag.",
          "oneOf": [
            { "maxLength": 0 },
            { "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "$ref": "#/definitions/localObjectReference" },
      "uniqueItems": true
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "deploymentStrategy": { "enum": ["RollingUpdate", "Recreate"] },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "backoffLimit",
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished",
        "annotations",
        "podAnnotations",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 20 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "maxLength": 253 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "control", "worker", "all"],
      "properties": {
        "gateway": { "$ref": "#/definitions/role" },
        "control": { "$ref": "#/definitions/clusterInternalRole" },
        "worker": { "$ref": "#/definitions/role" },
        "all": { "$ref": "#/definitions/clusterInternalRole" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "all": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            }
          },
          "then": {
            "properties": {
              "gateway": { "properties": { "enabled": { "const": false } } },
              "control": { "properties": { "enabled": { "const": false } } },
              "worker": { "properties": { "enabled": { "const": false } } }
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseMaxConnections",
        "databaseUrlSecret",
        "keyPepperSecret",
        "serviceTokenSecret",
        "memeloopCloudWebhookSecret",
        "archiveBackend",
        "s3",
        "upstream",
        "outboundProxy"
      ],
      "properties": {
        "databaseMaxConnections": { "type": "integer", "minimum": 1, "maximum": 64 },
        "databaseUrlSecret": { "$ref": "#/definitions/secretKeyRef" },
        "keyPepperSecret": { "$ref": "#/definitions/secretKeyRef" },
        "serviceTokenSecret": { "$ref": "#/definitions/secretKeyRef" },
        "memeloopCloudWebhookSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          },
          "description": "Optional existing Secret reference for the MemeLoop Cloud HMAC webhook. An empty name disables the integration fail-closed."
        },
        "archiveBackend": {
          "const": "s3",
          "description": "The Kubernetes chart deliberately supports only S3-compatible external object storage. Filesystem and memory backends remain test-only runtime options."
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket", "endpoint", "region", "allowHttp", "credentialsSecret"],
          "properties": {
            "bucket": { "type": "string", "minLength": 1 },
            "endpoint": { "type": "string" },
            "region": { "type": "string", "minLength": 1 },
            "allowHttp": { "type": "boolean" },
            "credentialsSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "accessKey", "secretKey"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "accessKey": { "type": "string", "minLength": 1 },
                "secretKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openaiUrl", "anthropicUrl"],
          "properties": {
            "openaiUrl": { "type": "string" },
            "anthropicUrl": { "type": "string" }
          }
        },
        "outboundProxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "noProxy"],
          "properties": {
            "url": { "type": "string" },
            "noProxy": { "type": "string" }
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mountPath", "existingConfigMap", "existingClaim"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string", "pattern": "^/", "minLength": 2 },
        "existingConfigMap": { "type": "string" },
        "existingClaim": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "existingConfigMap": { "minLength": 1 },
                  "existingClaim": { "maxLength": 0 }
                }
              },
              {
                "properties": {
                  "existingConfigMap": { "maxLength": 0 },
                  "existingClaim": { "minLength": 1 }
                }
              }
            ]
          }
        }
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "control"],
      "properties": {
        "gateway": { "$ref": "#/definitions/ingressEndpoint" },
        "control": { "$ref": "#/definitions/privateIngressEndpoint" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": {
      "type": "array",
      "items": { "$ref": "#/definitions/toleration" }
    },
    "affinity": { "$ref": "#/definitions/affinity" },
    "topologySpreadConstraints": {
      "type": "array",
      "items": { "$ref": "#/definitions/topologySpreadConstraint" }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": {
          "allOf": [
            { "$ref": "#/definitions/probe" },
            {
              "properties": {
                "timeoutSeconds": { "minimum": 7 }
              }
            }
          ]
        },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowSameNamespace", "controllerNamespaces", "extraRules"],
          "properties": {
            "allowSameNamespace": { "type": "boolean" },
            "controllerNamespaces": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "extraRules": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyIngressRule" }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dns",
            "allowSameNamespace",
            "clusterDependencies",
            "outboundProxy",
            "publicInternet",
            "extraRules"
          ],
          "properties": {
            "allowSameNamespace": { "type": "boolean" },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "namespaceSelector", "podSelector"],
              "properties": {
                "enabled": { "type": "boolean" },
                "namespaceSelector": { "$ref": "#/definitions/nonEmptyLabelSelector" },
                "podSelector": { "$ref": "#/definitions/nonEmptyLabelSelector" }
              }
            },
            "clusterDependencies": { "$ref": "#/definitions/cidrPortRule" },
            "outboundProxy": { "$ref": "#/definitions/cidrPortRule" },
            "publicInternet": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "cidrs", "ports"],
              "properties": {
                "enabled": { "type": "boolean" },
                "cidrs": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/ipBlock" }
                },
                "ports": { "$ref": "#/definitions/networkPolicyPorts" }
              },
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": {
                    "properties": {
                      "cidrs": { "minItems": 1 },
                      "ports": { "minItems": 1 }
                    }
                  }
                }
              ]
            },
            "extraRules": {
              "type": "array",
              "items": { "$ref": "#/definitions/networkPolicyEgressRule" }
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "interval",
        "scrapeTimeout",
        "sampleLimit",
        "path",
        "scheme",
        "labels",
        "annotations",
        "namespace",
        "namespaceSelector",
        "scraperNamespaces",
        "honorLabels",
        "authorizationSecret"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "scrapeTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "sampleLimit": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "path": { "type": "string", "pattern": "^/" },
        "scheme": { "enum": ["http", "https"] },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "namespace": { "type": "string" },
        "namespaceSelector": { "$ref": "#/definitions/serviceMonitorNamespaceSelector" },
        "scraperNamespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "honorLabels": { "type": "boolean" },
        "authorizationSecret": { "$ref": "#/definitions/secretKeyRef" }
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "localObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "resourceQuantity": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number", "minimum": 0 }
      ]
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "$ref": "#/definitions/resourceQuantity" },
        "memory": { "$ref": "#/definitions/resourceQuantity" },
        "ephemeral-storage": { "$ref": "#/definitions/resourceQuantity" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "required": ["type", "port"] }
        }
      ]
    },
    "clusterInternalService": {
      "allOf": [
        { "$ref": "#/definitions/service" },
        {
          "properties": {
            "type": { "const": "ClusterIP" }
          }
        }
      ]
    },
    "hpaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "periodSeconds"],
      "properties": {
        "type": { "enum": ["Pods", "Percent"] },
        "value": { "type": "integer", "minimum": 1 },
        "periodSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
      }
    },
    "hpaScalingRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stabilizationWindowSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "selectPolicy": { "enum": ["Max", "Min", "Disabled"] },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/hpaPolicy" },
          "minItems": 1
        }
      }
    },
    "metricIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "selector": { "$ref": "#/definitions/labelSelector" }
      }
    },
    "metricTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["Utilization", "Value", "AverageValue"] },
        "averageUtilization": { "type": "integer", "minimum": 1 },
        "averageValue": { "$ref": "#/definitions/resourceQuantity" },
        "value": { "$ref": "#/definitions/resourceQuantity" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "Utilization" } } },
          "then": { "required": ["averageUtilization"] }
        },
        {
          "if": { "properties": { "type": { "const": "Value" } } },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "type": { "const": "AverageValue" } } },
          "then": { "required": ["averageValue"] }
        }
      ]
    },
    "crossVersionObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "apiVersion": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "hpaMetric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "containerResource"],
          "properties": {
            "type": { "const": "ContainerResource" },
            "containerResource": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "target", "container"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "target": { "$ref": "#/definitions/metricTarget" },
                "container": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "external"],
          "properties": {
            "type": { "const": "External" },
            "external": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "target"],
              "properties": {
                "metric": { "$ref": "#/definitions/metricIdentifier" },
                "target": { "$ref": "#/definitions/metricTarget" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "object"],
          "properties": {
            "type": { "const": "Object" },
            "object": {
              "type": "object",
              "additionalProperties": false,
              "required": ["describedObject", "metric", "target"],
              "properties": {
                "describedObject": { "$ref": "#/definitions/crossVersionObjectReference" },
                "metric": { "$ref": "#/definitions/metricIdentifier" },
                "target": { "$ref": "#/definitions/metricTarget" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pods"],
          "properties": {
            "type": { "const": "Pods" },
            "pods": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "target"],
              "properties": {
                "metric": { "$ref": "#/definitions/metricIdentifier" },
                "target": { "$ref": "#/definitions/metricTarget" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "resource"],
          "properties": {
            "type": { "const": "Resource" },
            "resource": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "target"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "target": { "$ref": "#/definitions/metricTarget" }
              }
            }
          }
        }
      ]
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "metrics",
        "behavior"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "metrics": { "type": "array", "items": { "$ref": "#/definitions/hpaMetric" } },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scaleDown": { "$ref": "#/definitions/hpaScalingRules" },
            "scaleUp": { "$ref": "#/definitions/hpaScalingRules" }
          }
        }
      }
    },
    "intOrPercent": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(100|[0-9]{1,2})%$" }
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "$ref": "#/definitions/intOrPercent" },
        "maxUnavailable": { "$ref": "#/definitions/intOrPercent" }
      },
      "anyOf": [
        { "required": ["minAvailable"] },
        { "required": ["maxUnavailable"] }
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "service", "resources", "autoscaling", "podDisruptionBudget"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" }
      }
    },
    "clusterInternalRole": {
      "allOf": [
        { "$ref": "#/definitions/role" },
        {
          "properties": {
            "service": { "$ref": "#/definitions/clusterInternalService" }
          }
        }
      ]
    },
    "ingressEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "sourceRanges", "tlsSecretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "sourceRanges": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Strict IPv4 CIDR with a prefix length from 1 through 32; unrestricted /0 ranges are forbidden.",
            "minLength": 9,
            "maxLength": 18,
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[1-9]|[12][0-9]|3[0-2])$"
          },
          "uniqueItems": true
        },
        "host": { "type": "string" },
        "tlsSecretName": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": ["host"],
            "properties": { "host": { "minLength": 1 } }
          }
        }
      ]
    },
    "privateIngressEndpoint": {
      "allOf": [
        { "$ref": "#/definitions/ingressEndpoint" },
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "className": {
                "minLength": 1,
                "pattern": "(^|[-.])(higress|nginx)([-.]|$)"
              },
              "sourceRanges": { "minItems": 1 },
              "tlsSecretName": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "labelSelectorRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "enum": ["In", "NotIn"] } } },
          "then": {
            "required": ["values"],
            "properties": { "values": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "operator": { "enum": ["Exists", "DoesNotExist"] } } },
          "then": { "properties": { "values": { "maxItems": 0 } } }
        }
      ]
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": { "$ref": "#/definitions/stringMap" },
        "matchExpressions": {
          "type": "array",
          "items": { "$ref": "#/definitions/labelSelectorRequirement" }
        }
      }
    },
    "nonEmptyLabelSelector": {
      "allOf": [
        { "$ref": "#/definitions/labelSelector" },
        {
          "minProperties": 1,
          "anyOf": [
            {
              "required": ["matchLabels"],
              "properties": { "matchLabels": { "minProperties": 1 } }
            },
            {
              "required": ["matchExpressions"],
              "properties": { "matchExpressions": { "minItems": 1 } }
            }
          ]
        }
      ]
    },
    "serviceMonitorNamespaceSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "any": { "type": "boolean" },
        "matchNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "ipBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr"],
      "properties": {
        "cidr": { "type": "string", "minLength": 3 },
        "except": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "uniqueItems": true
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "ipBlock": { "$ref": "#/definitions/ipBlock" }
      },
      "oneOf": [
        {
          "required": ["ipBlock"],
          "not": {
            "anyOf": [
              { "required": ["podSelector"] },
              { "required": ["namespaceSelector"] }
            ]
          }
        },
        {
          "not": { "required": ["ipBlock"] },
          "anyOf": [
            { "required": ["podSelector"] },
            { "required": ["namespaceSelector"] }
          ]
        }
      ]
    },
    "networkPolicyPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] },
        "port": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "endPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "anyOf": [
        { "required": ["port"] },
        { "required": ["protocol"] }
      ]
    },
    "networkPolicyPorts": {
      "type": "array",
      "items": { "$ref": "#/definitions/networkPolicyPort" }
    },
    "networkPolicyIngressRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "array", "items": { "$ref": "#/definitions/networkPolicyPeer" } },
        "ports": { "$ref": "#/definitions/networkPolicyPorts" }
      },
      "minProperties": 1
    },
    "networkPolicyEgressRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": { "type": "array", "items": { "$ref": "#/definitions/networkPolicyPeer" } },
        "ports": { "$ref": "#/definitions/networkPolicyPorts" }
      },
      "minProperties": 1
    },
    "cidrPortRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "cidrs", "ports"],
      "properties": {
        "enabled": { "type": "boolean" },
        "cidrs": { "type": "array", "items": { "type": "string", "minLength": 3 }, "uniqueItems": true },
        "ports": { "$ref": "#/definitions/networkPolicyPorts" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "cidrs": { "minItems": 1 },
              "ports": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "toleration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "operator": { "enum": ["Equal", "Exists"] },
        "value": { "type": "string" },
        "effect": { "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
        "tolerationSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "nodeSelectorRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator", "values"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist", "Gt", "Lt"] },
        "values": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "enum": ["In", "NotIn"] } } },
          "then": { "properties": { "values": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "operator": { "enum": ["Exists", "DoesNotExist"] } } },
          "then": { "properties": { "values": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "operator": { "enum": ["Gt", "Lt"] } } },
          "then": { "properties": { "values": { "minItems": 1, "maxItems": 1 } } }
        }
      ]
    },
    "nodeSelectorTerm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchExpressions": { "type": "array", "items": { "$ref": "#/definitions/nodeSelectorRequirement" } },
        "matchFields": { "type": "array", "items": { "$ref": "#/definitions/nodeSelectorRequirement" } }
      },
      "minProperties": 1
    },
    "podAffinityTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topologyKey"],
      "properties": {
        "labelSelector": { "$ref": "#/definitions/labelSelector" },
        "namespaces": { "type": "array", "items": { "type": "string" } },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "topologyKey": { "type": "string", "minLength": 1 },
        "matchLabelKeys": { "type": "array", "items": { "type": "string" } },
        "mismatchLabelKeys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "weightedPodAffinityTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "podAffinityTerm"],
      "properties": {
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "podAffinityTerm": { "$ref": "#/definitions/podAffinityTerm" }
      }
    },
    "podAffinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "type": "array",
          "items": { "$ref": "#/definitions/podAffinityTerm" }
        },
        "preferredDuringSchedulingIgnoredDuringExecution": {
          "type": "array",
          "items": { "$ref": "#/definitions/weightedPodAffinityTerm" }
        }
      }
    },
    "nodeAffinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeSelectorTerms"],
          "properties": {
            "nodeSelectorTerms": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/nodeSelectorTerm" }
            }
          }
        },
        "preferredDuringSchedulingIgnoredDuringExecution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weight", "preference"],
            "properties": {
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
              "preference": { "$ref": "#/definitions/nodeSelectorTerm" }
            }
          }
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": { "$ref": "#/definitions/nodeAffinity" },
        "podAffinity": { "$ref": "#/definitions/podAffinity" },
        "podAntiAffinity": { "$ref": "#/definitions/podAffinity" }
      }
    },
    "topologySpreadConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"],
      "properties": {
        "maxSkew": { "type": "integer", "minimum": 1 },
        "topologyKey": { "type": "string", "minLength": 1 },
        "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] },
        "labelSelector": { "$ref": "#/definitions/labelSelector" },
        "minDomains": { "type": "integer", "minimum": 1 },
        "nodeAffinityPolicy": { "enum": ["Honor", "Ignore"] },
        "nodeTaintsPolicy": { "enum": ["Honor", "Ignore"] },
        "matchLabelKeys": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
