# syntax=docker/dockerfile:1.7
ARG RUNTIME_IMAGE=alpine:3.23.5
ARG NODE_IMAGE=node:24.18.0-bookworm-slim

FROM ${NODE_IMAGE} AS scripts
ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /source
COPY package.json package-lock.json ./
RUN npm config set registry "${NPM_REGISTRY}" && npm ci --ignore-scripts
COPY tsconfig.scripts.json ./
COPY ops/cpa-upstreams ./ops/cpa-upstreams
COPY ops/legacy-credentials ./ops/legacy-credentials
COPY ops/lib ./ops/lib
RUN npm run build:importer-scripts

FROM ${RUNTIME_IMAGE}
USER root
RUN apk add --no-cache ca-certificates nodejs postgresql-client sqlite \
    && adduser -S -D -u 10001 importer
COPY ops/migrate-cpamp.sh /usr/local/bin/migrate-cpamp
COPY ops/audit-cpa-migration.sh /usr/local/bin/audit-cpa-migration
COPY --from=scripts /source/dist/operator-scripts/legacy-credentials/attach-legacy-cpa-credentials.cjs /usr/local/bin/attach-legacy-cpa-credentials
COPY --from=scripts /source/dist/operator-scripts/cpa-upstreams/import-cpa-upstreams.cjs /usr/local/bin/import-cpa-upstreams
COPY --from=scripts /source/dist/operator-scripts/cpa-upstreams/generate-source-identity-key.cjs /usr/local/bin/generate-source-identity-key
RUN chmod 0555 /usr/local/bin/migrate-cpamp /usr/local/bin/audit-cpa-migration \
    /usr/local/bin/attach-legacy-cpa-credentials \
    /usr/local/bin/import-cpa-upstreams \
    /usr/local/bin/generate-source-identity-key
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/migrate-cpamp"]
