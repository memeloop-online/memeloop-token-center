# syntax=docker/dockerfile:1.7
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM ${RUNTIME_IMAGE}
ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
RUN sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates postgresql-client sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home importer
COPY --chmod=0555 ops/migrate-cpamp.sh /usr/local/bin/migrate-cpamp
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/migrate-cpamp"]
